#!/bin/bash

PATH=/c/Program\ Files/MiKTeX\ 2.9/miktex/bin/x64/:$PATH
export BIBINPUTS=$PWD/../../bib
export TEXINPUTS=$PWD/../../tex/classes:$PWD/../../tex/macros

MAINTEX="main"
if [ -n "$1" ]; then MAINTEX="$1"; fi 
pdflatex.exe ${MAINTEX} \
	&& pdflatex.exe ${MAINTEX} \
	&& bibtex.exe ${MAINTEX} \
	&& pdflatex.exe ${MAINTEX}  
