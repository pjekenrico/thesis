@article{Bouillot2016,
  abstract  = {The prediction of flow diverter stent (FDS) implantation for the treatment of intracranial aneurysms (IAs) is being increasingly required for hemodynamic simulations and procedural planning. In this paper, a deployment model was developed based on geometrical properties of braided stents. The proposed mathematical description is first applied on idealized toroidal vessels demonstrating the stent shortening in curved vessels. It is subsequently generalized to patient specific vasculature predicting the position of the filaments along with the length and local porosity of the stent. In parallel, in-vitro and in-vivo FDS deployments were measured by contrast-enhanced cone beam CT (CBCT) in idealized and patient-specific geometries. These measurements showed a very good qualitative and quantitative agreement with the virtual deployments and provided experimental validations of the underlying geometrical assumptions. In particular, they highlighted the importance of the stent radius assessment in the accuracy of the deployment prediction. Thanks to its low computational cost, the proposed model is potentially implementable in clinical practice providing critical information for patient safety and treatment outcome assessment.},
  author    = {Pierre Bouillot and Olivier Brina and Rafik Ouared and Hasan Yilmaz and Mohamed Farhat and Gorislav Erceg and Karl Olof Lovblad and Maria Isabel Vargas and Zsolt Kulcsar and Vitor Mendes Pereira},
  doi       = {10.1016/j.media.2016.01.006},
  issn      = {13618423},
  journal   = {Medical Image Analysis},
  keywords  = {Braided stent,Flow diverter stent,Geometrical model,Intracranial aneurysm,Virtual deployment},
  month     = {5},
  pages     = {85-94},
  pmid      = {26891065},
  publisher = {Elsevier B.V.},
  title     = {Geometrical deployment for braided stent},
  volume    = {30},
  year      = {2016}
}


@article{Rebelo2015,
  abstract        = {In spite of all innovations in stent design, commonly used metallic stents present several problems such as corrosion, infection and restenosis, leading to health complications or even death of patients. In this context, the present paper reports a systematic investigation on designing and development of 100% fiber based stents, which can eliminate or minimize the problems with existing metallic stents. For this purpose, braided stents were produced by varying different materials, structural and process parameters such as mono-filament type and diameter, braiding angle and mandrel diameter. The influence of these design parameters on mechanical behavior as well as stent's porosity was thoroughly investigated, and suitable parameters were selected for developing a stent with mechanical characteristics and porosity matching with the commercial stents. According to the experimental results, the best performance was achieved with a polyester stent designed with 0.27. mm monofilament diameter, braiding angle of 35° and mandrel diameter of 6. mm, providing similar properties to commercial Nitinol stents.},
  author          = {Rebelo, Rita and Vila, N{\'{i}}vea and Fangueiro, Raul and Carvalho, Sandra and Rana, Sohel},
  doi             = {10.1016/j.matdes.2015.07.051},
  file            = {:home/admin-pjekenrico/Documents/Papers/1-s2.0-S0264127515301210-main.pdf:pdf},
  issn            = {18734197},
  journal         = {Materials and Design},
  keywords        = {Braiding,Design parameters,Fibrous stents,Mechanical behavior,Porosity},
  mendeley-groups = {Stenting},
  pages           = {237--247},
  publisher       = {Elsevier Ltd},
  title           = {{Influence of design parameters on the mechanical behavior and porosity of braided fibrous stents}},
  url             = {http://dx.doi.org/10.1016/j.matdes.2015.07.051},
  volume          = {86},
  year            = {2015}
}


@article{Janiga2013,
abstract = {In order to support the decisions of medical experts and to develop better stent designs, the availability of a simulation tool for virtual stenting would be extremely useful. An innovative virtual stenting technique is described in this work, which is directly applicable for complex patient-specific geometries. A basilar tip aneurysm provided for the Virtual Intracranial Stenting Challenge 2010 is considered to demonstrate the advantages of this approach. A free-form deformation is introduced for a wall-tight stent deployment. Numerical flow simulations on sufficiently fine computational meshes are performed for different configurations in order to characterize the inflow rate into the aneurysm and the corresponding residence time in the aneurysm sac. A Neuroform and a SILK stent have been deployed at various locations and the computed residence times have been evaluated and compared, demonstrating the advantage associated with a lower stent porosity. It has been found that the SILK stent leads to a large increase in the residence time and to a significant reduction in the maximum wall shear stress in the aneurysm sac. This is only observed when placing the stent in the appropriate position, showing that virtual stenting might be employed for operation support. {\textcopyright} 2012 Elsevier Ltd.},
author = {Janiga, G{\'{a}}bor and R{\"{o}}ssl, Christian and Skalej, Martin and Th{\'{e}}venin, Dominique},
doi = {10.1016/j.jbiomech.2012.08.047},
file = {:home/admin-pjekenrico/.var/app/com.elsevier.MendeleyDesktop/data/data/Mendeley Ltd./Mendeley Desktop/Downloaded/Janiga et al. - 2013 - Realistic virtual intracranial stenting and computational fluid dynamics for treatment analysis.pdf:pdf},
issn = {00219290},
journal = {Journal of Biomechanics},
keywords = {CFD,Cerebral aneurysms,Hemodynamics,Mesh deformation,VISC,Virtual stenting},
mendeley-groups = {Stenting},
month = {jan},
number = {1},
pages = {7--12},
pmid = {23063770},
title = {{Realistic virtual intracranial stenting and computational fluid dynamics for treatment analysis}},
volume = {46},
year = {2013}
}
